# Base de datos PostgreSQL
POSTGRES_USER=ecoconecta
POSTGRES_PASSWORD=
POSTGRES_DB=ecoconecta
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Opcional: si se deja vacía, se construye desde POSTGRES_* con el dialecto postgresql+psycopg
# Para Supabase, usar la URL del pooler compartido en modo sesión (puerto 5432)
DATABASE_URL=

# Seguridad Backend (JWT)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Orígenes permitidos por CORS (separados por coma); ajustar al frontend desplegado
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Usar production o pilot para deshabilitar POST /api/auth/demo-login
ENTORNO=development

# Credenciales configurables para la semilla (obligatoria para ejecutar seed.py; no subir valores reales)
SEED_DEFAULT_PASSWORD=
# Opcionales por rol (si se omiten, heredan SEED_DEFAULT_PASSWORD)
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_COORD_HUERTEROS=
SEED_PASSWORD_HUERTERO=
SEED_PASSWORD_COORD_RECICLADORES=
SEED_PASSWORD_RECICLADOR=
SEED_PASSWORD_UNIDAD_PRODUCTIVA=
SEED_PASSWORD_HOGAR=
# Cambiar a true solo si deseas actualizar los password_hash existentes al volver a ejecutar la semilla
SEED_RESET_PASSWORDS=false

# Proveedor activo de avisos salientes: auto | meta | twilio
WHATSAPP_PROVEEDOR=auto

# WhatsApp Cloud API (Meta · Graph API v25.0)
# Token explícito exigido en GET /api/webhooks/whatsapp (obligatorio para suscribir el webhook)
WHATSAPP_VERIFY_TOKEN=
# App Secret de Meta usado para verificar X-Hub-Signature-256 sobre el cuerpo original
WHATSAPP_APP_SECRET=
# Token permanente o de usuario del sistema y Phone Number ID del número receptor en Meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
# Plantillas aprobadas en Meta (código de idioma y nombres por evento y destinatario)
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_TEMPLATE_PROGRAMADA_RECOLECTOR=
WHATSAPP_TEMPLATE_PROGRAMADA_SOLICITANTE=
WHATSAPP_TEMPLATE_RECOLECTADA_RECOLECTOR=
WHATSAPP_TEMPLATE_RECOLECTADA_SOLICITANTE=
WHATSAPP_TEMPLATE_DEFAULT=
WHATSAPP_TEMPLATE_SIN_VARIABLES=false
# Si es true, solo se envían avisos al solicitante cuando existe consentimiento explícito registrado
WHATSAPP_EXIGIR_CONSENTIMIENTO_EXPLICITO=false

# Gemini (google-genai) para extracción estructurada de solicitudes Meta
# Se usa gemini-3.5-flash-lite porque Google retirará gemini-2.5-flash el 1 de diciembre de 2026
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_INTENTOS=3
GEMINI_BACKOFF_BASE_SEGUNDOS=15

# WhatsApp con Twilio (flujo alterno coexistente)
# Account SID y Auth Token de Twilio; el token se usa para validar X-Twilio-Signature
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Remitente configurado en Twilio, por ejemplo whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=
# Content SID aprobado en Twilio; vacío usa texto libre dentro de la ventana de 24 h
TWILIO_CONTENT_SID=
TWILIO_CONTENT_SIN_VARIABLES=true
WEBHOOK_PUBLIC_URL=

# IA alterna (flujo Twilio): OpenAI o Azure OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
IA_PROVEEDOR=openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_AUDIO_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_MODE=classic

# Frontend (React + Vite)
VITE_API_URL=http://localhost:8000
# Mantener en false en piloto para exigir inicio de sesión con teléfono y contraseña
VITE_ENABLE_DEMO_LOGIN=false
FRONTEND_PORT=5173
