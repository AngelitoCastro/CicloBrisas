# Base de datos PostgreSQL
POSTGRES_USER=ecoconecta
POSTGRES_PASSWORD=
POSTGRES_DB=ecoconecta
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Opcional: si se deja vacía, se construye desde POSTGRES_* con el dialecto postgresql+psycopg.
# Con Supabase, pega aquí la cadena del pooler compartido (modo sesión, puerto 5432).
# Codifica los caracteres especiales del password y no subas este archivo con valores reales.
DATABASE_URL=

# Seguridad Backend (JWT)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Orígenes permitidos por CORS (separados por coma); incluye el dev server de Vite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ENTORNO=development

# Credenciales configurables para la semilla (obligatoria para ejecutar seed.py; no subir valores reales)
SEED_DEFAULT_PASSWORD=
# Opcionales por rol (si se omiten, heredan SEED_DEFAULT_PASSWORD)
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_COORD_HUERTEROS=
SEED_PASSWORD_HUERTERO=
SEED_PASSWORD_COORD_RECICLADORES=
SEED_PASSWORD_RECICLADOR=
SEED_PASSWORD_UNIDAD_PRODUCTIVA=
SEED_PASSWORD_HOGAR=
# Cambiar a true solo si deseas actualizar los password_hash existentes al volver a ejecutar la semilla
SEED_RESET_PASSWORDS=false

# WhatsApp con Twilio
# Account SID y Auth Token de Twilio; el token se usa para validar X-Twilio-Signature
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Remitente configurado en Twilio, por ejemplo whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=
# Content SID aprobado en Twilio; vacío usa texto libre dentro de la ventana de 24 h
TWILIO_CONTENT_SID=

# IA: openai (default) o azure para clasificación, redacción, visión y transcripción
IA_PROVEEDOR=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Azure OpenAI (solo cuando IA_PROVEEDOR=azure)
# Keys and Endpoint del recurso; sin barra final o terminado en /openai/v1 si usas la API v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Nombre del deployment, no el modelo base; se usa en la URL del modo classic y como model en v1
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Deployment de transcripción; si se omite se reutiliza AZURE_OPENAI_CHAT_DEPLOYMENT
AZURE_OPENAI_AUDIO_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# classic: /openai/deployments/<deployment>/... | v1: /openai/v1/...
AZURE_OPENAI_API_MODE=classic

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173
